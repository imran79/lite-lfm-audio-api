# =============================================================================
# LiveKit + Ollama + LFM Audio — Environment Configuration
# =============================================================================

# LiveKit Server (self-hosted)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LLM Configuration
LLM_PROVIDER=ollama  # Options: ollama, groq, openai

# Ollama (Local)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=90

# Groq (Cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (Cloud)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# LFM 2.5 Audio (TTS)
MODEL_DIR=/app/models
RUNNER_PATH=/app/runners/llama-liquid-audio-cli
TTS_VOICE=us_male

# Faster-Whisper (STT)
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Agent
AGENT_NAME=lfm-audio-agent

# Turn-handling (reduces false cutoffs)
MIN_ENDPOINTING_DELAY=0.6
MAX_ENDPOINTING_DELAY=2.0
MIN_CONSECUTIVE_SPEECH_DELAY=0.15
MIN_INTERRUPTION_DURATION=0.6
MIN_INTERRUPTION_WORDS=2
ALLOW_INTERRUPTIONS=true
RESUME_FALSE_INTERRUPTION=true
FALSE_INTERRUPTION_TIMEOUT=2.0
